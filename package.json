{
  "name": "gearhead",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma Gearhead — site, painel e app para entusiastas automotivos no Brasil.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:web": "npm run dev -w @gearhead/web",
    "dev:mobile": "npm run start -w @gearhead/mobile",
    "build:web": "npm run build -w @gearhead/web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:lint": "supabase db lint --level warning --fail-on warning",
    "db:new": "supabase migration new",
    "db:types": "supabase gen types typescript --local --schema public > packages/shared/src/database.types.ts && prettier --write packages/shared/src/database.types.ts",
    "test:integration": "node scripts/with-local-supabase.mjs npm run test -w @gearhead/shared"
  },
  "devDependencies": {
    "prettier": "^3.9.10",
    "supabase": "^2.121.0"
  }
}
