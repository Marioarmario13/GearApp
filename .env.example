# Copie para apps/web/.env.local e apps/mobile/.env.local conforme o app.
# Valores locais: `npm run db:status` (campo PUBLISHABLE_KEY / "Publishable key").
# Use SOMENTE a chave publishable. NUNCA coloque a secret/service_role em
# variáveis NEXT_PUBLIC_* ou EXPO_PUBLIC_* — elas vão para o navegador/app.

# --- apps/web/.env.local ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:44321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- apps/mobile/.env.local ---
# Em celular físico (Expo Go), troque 127.0.0.1 pelo IP da sua máquina na rede local.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:44321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
