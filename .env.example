# Copie para apps/web/.env.local e apps/mobile/.env.local conforme o app.
# NUNCA coloque a chave service_role em variáveis NEXT_PUBLIC_* ou EXPO_PUBLIC_*.
# Os valores reais serão definidos na Etapa 2 (Supabase local: `npx supabase status`).

# --- apps/web (.env.local) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- apps/mobile (.env.local) ---
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
